# Virtual environment
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Pytest
.pytest_cache/
/.tmp_nuget/
/tmp_*.py
/tmp_*.json

# Data files (raw sources and output — not tracked in git)
data/raw/**
data/out/**
data/cache/**
data/.etl_staging/**
data/.etl_backup/**
data/.etl.lock

# Keep folder structure in git
# (нужно сначала "открыть" сами подпапки, иначе git не спустится внутрь
# них, чтобы применить !.../.gitkeep — иначе негейт ниже не срабатывает)
!data/raw/.gitkeep
!data/raw/*/
!data/raw/*/.gitkeep
!data/out/.gitkeep
!data/cache/.gitkeep

# Сформированные отчёты могут содержать кадровые и персональные данные
reports/**
!reports/.gitkeep
!reports/powerbi_cleanup_plan.json

# Power BI
*.pbix
/tmp_pbix_unpack/

# Случайные экспорты/архивы в корне проекта (не путать с config/*.xlsx —
# те легитимные и трекаются намеренно)
/*.xlsx
/*.csv
/*.zip

# OS
.DS_Store
Thumbs.db
